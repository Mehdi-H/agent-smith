{
    "document": {
        "block_prefix": "\n",
        "block_suffix": "\n",
        "color": "7",
        "margin": 2
    },
    "block_quote": {
        "indent": 1,
        "indent_token": "│ ",
        "color": "7"
    },
    "list": {
        "level_indent": 2
    },
    "heading": {
        "block_suffix": "\n",
        "color": "12",
        "bold": true
    },
    "h1": {
        "prefix": " ",
        "suffix": " ",
        "color": "15",
        "background_color": "4",
        "bold": true
    },
    "h2": {
        "color": "13"
    },
    "h3": {
        "color": "14"
    },
    "emph": {
        "italic": true
    },
    "strong": {
        "bold": true
    },
    "item": {
        "block_prefix": "• "
    },
    "enumeration": {
        "block_prefix": ". "
    },
    "link": {
        "format": "{{ \"\" }}"
    },
    "link_text": {
        "color": "10"
    },
    "image": {
        "format": "{{ \"\" }}"
    },
    "image_text": {
        "format": "{{.text}}",
        "color": "10"
    },
    "code": {
        "prefix": " ",
        "suffix": " ",
        "color": "11",
        "background_color": "0"
    },
    "code_block": {
        "margin": 2,
        "theme": "catppuccin-mocha"
    }
}
